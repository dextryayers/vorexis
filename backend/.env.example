# ===== Core =====
# JWT signing secret — WAJIB ganti dengan nilai acak panjang untuk produksi
SECRET_KEY=aipentest-dev-secret-key-please-rotate-2026!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ===== Database & Engine =====
DATABASE_URL=backend/data/aipentest.db
ENGINE_BINARY=../engine/target/release/aipentest-engine
ENGINE_TIMEOUT=900

# ===== AI Providers (semua opsional) =====
# Provider default; fallback otomatis: requested -> default -> semua yang available -> ollama
DEFAULT_AI_PROVIDER=openai
AI_MAX_TOKENS=1024

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# HuggingFace
HF_API_KEY=
HF_MODEL=meta-llama/Llama-3.2-3B-Instruct

# Ollama (lokal, tanpa API key) — cukup install Ollama + pull model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
